# Copy this file to .env and replace the example values.
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-this-local-password
MONGODB_HOST=localhost
USER_DB_PORT=27020
PRODUCT_DB_PORT=27018
MEDIA_DB_PORT=27019

USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
MEDIA_SERVICE_PORT=8083
API_GATEWAY_PORT=8080
EUREKA_SERVER_PORT=8761
EUREKA_HOSTNAME=localhost
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Generate a unique value with: openssl rand -base64 32
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000